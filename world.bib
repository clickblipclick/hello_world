% world.bib
%
% For those who have to say where they got it. Put this file beside whatever
% you are writing and cite the key; the machine will do the rest and get the
% capitals wrong, as it does for everybody.
%
% Fields that could not be filled in honestly have been filled in honestly.

@misc{world,
  title        = {hello world},
  author       = {{nobody in particular}},
  year         = {n.d.},
  howpublished = {\url{https://helloworldandthen.com/}},
  address      = {behind the glass},
  edition      = {this one},
  pages        = {1},
  note         = {Consulted while turning. No two readers have seen the same face of it,
                  and the one cited here has since gone round the back.}
}

% The parts, for anyone who only used a part.

@incollection{sea,
  title     = {The sea},
  author    = {{the Tildes}},
  booktitle = {hello world},
  year      = {n.d.},
  pages     = {most of it},
  note      = {All one wavelength. Quote any wave; they will not know which was meant.}
}

@incollection{caps,
  title     = {The ice},
  author    = {{the Asterisk Caps}},
  booktitle = {hello world},
  year      = {n.d.},
  pages     = {top and bottom},
  note      = {Each flake a footnote. Citing one therefore counts as citing a note,
               and should be marked with a star of your own.}
}

@unpublished{caret,
  title  = {Log},
  author = {{the Caret}},
  year   = {n.d.},
  note   = {Under way. Not seen by the present writer, nor offered.
            Cited in the hope that it exists.}
}

@misc{at,
  title        = {Personal communication},
  author       = {{the At}},
  year         = {n.d.},
  howpublished = {in passing},
  note         = {It passed. Nothing was communicated. The form requires an entry
                  for anything relied upon, and it was relied upon to come round again.}
}

@misc{apostrophes,
  title  = {Untitled},
  author = {{the Apostrophes} and others},
  year   = {n.d.},
  note   = {Cited \emph{passim}, which is also how they blink.}
}

@misc{reader,
  title  = {Looking},
  author = {{you}},
  year   = {just now},
  note   = {The only source here with a date. Cite yourself last; it is good manners
            and alphabetical besides.}
}
